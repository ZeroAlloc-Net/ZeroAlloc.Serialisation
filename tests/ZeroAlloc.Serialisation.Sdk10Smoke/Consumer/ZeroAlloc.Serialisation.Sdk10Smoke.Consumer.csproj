<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.Serialisation and ZeroAlloc.Serialisation.SystemTextJson
    packages with the oldest supported .NET SDK band, 10.0.1xx, whose compiler is Roslyn 5.0. Since
    2.0 ZeroAlloc.Serialisation bundles the generator in analyzers/dotnet/cs. A generator built
    against a newer Roslyn than the compiler that loads it is skipped with CS9057, and then
    OrderSerializer does not exist, so the build fails with CS0246. CS9057 is an error here as well.

    The standalone ZeroAlloc.Serialisation.Generator package ships the same DLL and cannot be
    referenced next to ZeroAlloc.Serialisation, because the generator would run twice. The
    roslyn-floor job scans its DLL.

    The parent folder's global.json pins the 10.0.1xx band with rollForward latestPatch, so a
    newer band cannot stand in for it. Run locally with a 10.0.1xx SDK installed:
      v=9.9.9-local.sha$(git rev-parse HEAD | cut -c1-7).$(date +%s)
      dotnet pack ZeroAlloc.Serialisation.slnx -c Release -o artifacts -p:Version=$v
      cd tests/ZeroAlloc.Serialisation.Sdk10Smoke/Consumer
      dotnet run -c Release -p:ZeroAllocSerialisationVersion=$v
    Not part of the solution; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS9057</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocSerialisationVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocSerialisationVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocSerialisationVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Serialisation" Version="[$(ZeroAllocSerialisationVersion)]" />
    <PackageReference Include="ZeroAlloc.Serialisation.SystemTextJson" Version="[$(ZeroAllocSerialisationVersion)]" />
  </ItemGroup>
</Project>
