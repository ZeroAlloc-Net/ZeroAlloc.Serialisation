<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    The System.Text.Json fallback types are excluded from the netstandard2.1
    TFM (see Compile Remove above), so their public API entries must only
    apply to the modern TFMs that compile those files. The shipped half of that
    pair is PublicAPI.Shipped.modern.txt; the release-please ship step moves the
    modern Unshipped entries there, not into PublicAPI.Shipped.txt.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <AdditionalFiles Include="PublicAPI.Shipped.modern.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.modern.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Remove="SystemTextJsonFallbackDispatcher.cs" />
    <Compile Remove="SerializerDispatcherFallbackExtensions.cs" />
  </ItemGroup>

  <!--
    Bundle the source generator into the NuGet package so consumers get it by
    referencing only ZeroAlloc.Serialisation. The standalone
    ZeroAlloc.Serialisation.Generator package is still published for backwards
    compatibility, but new consumers should reference the main package only.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Serialisation.Generator\ZeroAlloc.Serialisation.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
  <!--
    build/ makes ZeroAllocGeneratedAccessibility CompilerVisible for a project that references this
    package directly. buildTransitive/ does the same for a project that only gets it transitively,
    through a project reference to another project that references this package: the generator's
    analyzer, packed below, runs for those consumers too. See #185.
  -->
  <ItemGroup>
    <!-- Remove the implicit default-glob None items for these two files before re-adding them
         explicitly below, so pack metadata is set exactly once and dotnet pack does not fail with
         NETSDK1022 (duplicate 'None' items). -->
    <None Remove="build\ZeroAlloc.Serialisation.props" />
    <None Remove="buildTransitive\ZeroAlloc.Serialisation.props" />
    <None Include="$(MSBuildThisFileDirectory)build\ZeroAlloc.Serialisation.props"
          Pack="true"
          PackagePath="build/ZeroAlloc.Serialisation.props" />
    <None Include="$(MSBuildThisFileDirectory)buildTransitive\ZeroAlloc.Serialisation.props"
          Pack="true"
          PackagePath="buildTransitive/ZeroAlloc.Serialisation.props" />
  </ItemGroup>
  <!--
    Bundle the generator DLL the build actually produced. Asking the generator project for its
    target path, instead of hardcoding bin\$(Configuration)\netstandard2.0, follows any output
    redirection such as artifacts-path. The hardcoded path silently bundled whatever stale DLL
    sat in the repository's bin folder, at whatever version that DLL had been built with.
    See ZeroAlloc-Net/.github#43.
  -->
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\ZeroAlloc.Serialisation.Generator\ZeroAlloc.Serialisation.Generator.csproj"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_ZeroAllocSerialisationGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_ZeroAllocSerialisationGeneratorAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>
</Project>
